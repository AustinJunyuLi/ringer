# Sample config for ringer.py.
# Copy to ~/.config/ringer/config.toml or pass with --config /path/to/config.toml.

# Default identity stamped into state JSON and eval rows. Resolution order:
# --identity flag > FLEET_IDENTITY / RINGER_IDENTITY env > a .fleet-agent file
# found walking up from the working directory (per-repo agent name) > this
# value > short hostname.
# identity_default = "codex-mini"

# State files live under <state_dir>/runs/<run_id>.json.
state_dir = "~/.ringer"

# First localhost port tried for the per-run dashboard. The server will scan the
# next 49 ports if this one is busy.
dashboard_port_base = 8787

# Optional native HUD app path. Public installs should omit this and let the
# dashboard open in the browser.
# hud_app_path = "/Applications/Ringside.app"

# Belt-and-suspenders full-access gate. A task with "full_access": true will
# still fail unless this is true.
allow_full_access = false

[update]
# Check origin/main before command dispatch and let a long-running HUD check
# again on this interval. Updates apply only as a clean ff-only move on main.
# Set auto=false to disable both automatic paths; `./ringer.py self-update`
# remains available as an explicit check.
# auto = true
# check_interval_s = 3600
# For one command, pass --no-self-update. To disable automatic checks in an
# environment or service, set RINGER_NO_SELF_UPDATE=1.

# Optional model steering. The directory must contain profiles/ with one
# Markdown profile per model. Ringer creates observations/ringer/ beneath this
# directory automatically as attempts finish.
# [steering]
# dir = "~/.ringer/steering"
# inject_candidates = true

[eval]
# Safe public default: write one JSON object per attempt to a local JSONL file.
# Use "postgres" only when [eval.postgres] is configured.
backend = "jsonl"
jsonl_path = "~/.ringer/runs.jsonl"

# Optional Supabase/Postgres logging. The env file should define:
# SUPABASE_DB_HOST, SUPABASE_DB_PORT, SUPABASE_DB_USER,
# SUPABASE_DB_PASSWORD, SUPABASE_DB_NAME.
# [eval.postgres]
# env_file = "~/.supabase.env"

[engines.codex]
# Public default resolves this with shutil.which("codex"). Set an absolute path
# here only for machine-specific installs.
bin = "codex"

# Placeholders:
# - {taskdir}: task working directory
# - {spec}: task prompt/spec
# - {access_args}: expands to sandbox_args or full_access_args
# - {model_args}: expands to "-m <model>" only when the manifest task sets
#   "model" or this engine sets model_default; otherwise it expands to nothing,
#   preserving Codex's configured default. Setting model_default = "gpt-5.6-sol"
#   pins the model instead of inheriting ~/.codex/config.toml drift and makes
#   scoreboard attribution exact.
# - {engine_args}: expands to the task's optional "engine_args" list — the orchestrator
#   sets per-task flags here, e.g. ["-c", "model_reasoning_effort=medium"] to match
#   reasoning depth to task difficulty instead of inheriting the CLI-wide default
args_template = [
  "exec",
  "--skip-git-repo-check",
  "{access_args}",
  "{model_args}",
  "{engine_args}",
  "-C",
  "{taskdir}",
  "{spec}",
]

# Never rely on an engine's default sandbox. Be explicit.
sandbox_args = ["--sandbox", "workspace-write"]
full_access_args = ["--dangerously-bypass-approvals-and-sandbox"]

# First capture group should be the integer token count.
token_regex = "tokens\\s+used\\s*:?\\s*([0-9][0-9,]*)"

# First capture group should be the model slug self-reported by the harness.
# Ringer applies this to captured worker output after every attempt. The Codex
# default reads the `model:` header; override it here only if that format changes.
model_report_regex = "(?m)^model:[ \\t]*([^ \\t\\r\\n]+)[ \\t]*\\r?$"

# Grok Build CLI (xAI). Install: curl -fsSL https://x.ai/cli/install.sh | bash
# (or: npm install -g @xai-official/grok), then `grok login` — OAuth on a
# SuperGrok or X Premium Plus plan. Headless mode (-p) runs a full agentic
# loop with tools and exits. Grok brings its own OS sandbox (Seatbelt on
# macOS): profile "workspace" = read everywhere, write CWD + temp + ~/.grok,
# network allowed. Models: grok-build, grok-composer-2.5-fast (route with the
# per-task "model" field). Verified against Grok Build v0.2.81 (2026-07-06).
# Note: --no-auto-update is accepted but absent from --help in v0.2.81 (grok
# rejects unknown flags, so this is a hidden flag, not a typo) — it stops the
# CLI self-updating mid-swarm.
# Uncomment to enable.
# [engines.grok]
# bin = "grok"
# model_default = "grok-composer-2.5-fast"
# args_template = [
#   "--cwd",
#   "{taskdir}",
#   "{access_args}",
#   "-m",
#   "{model}",
#   "--always-approve",
#   "--no-auto-update",
#   "--output-format",
#   "json",
#   "{engine_args}",
#   "-p",
#   "{spec}",
# ]
# sandbox_args = ["--sandbox", "workspace"]
# full_access_args = ["--sandbox", "off", "--permission-mode", "bypassPermissions"]
# Grok's JSON output carries no usage/token fields (verified v0.2.81) — plan
# CLIs report cost as "included in plan"; regex is a harmless no-match. Its JSON
# also does not self-report a model, so no model_report_regex is configured.
# token_regex = "\"total_tokens\"\\s*:\\s*([0-9]+)"

# For CI, acceptance evals, and trying Ringer without an API bill.
# [engines.mock]
# bin = "python3"
# args_template = [
#   "/absolute/path/to/ringer/engines/mock_worker.py",
#   "{spec}",
# ]
# sandbox_args = []
# full_access_args = []

# OpenCode + OpenRouter — the universal model harness. One engine block runs
# ANY OpenRouter-served model: the {model} placeholder is filled per task from
# the manifest's "model" field, falling back to model_default below. Example
# default: GLM-5.2 (z-ai/glm-5.2, roughly $0.74/M input, $2.33/M output as of
# 2026-07) — the cheap-intelligence lane.
# OpenCode has no OS sandbox, so `bin` points at engines/opencode-sandboxed.sh
# (macOS Seatbelt: network + reads open, writes confined to the task dir, a
# per-run scratch dir, and OpenCode's state/config dirs). Auth: put your
# OpenRouter key where your OpenCode version expects it — commonly
# ~/.local/share/opencode/auth.json ({"openrouter": {"type": "api", "key": "..."}});
# confirm the path with your installed CLI.
# Per-task engine_args can set reasoning effort ("--variant", "low|high|max").
# Uncomment and set an absolute path for `bin` to enable.
# [engines.opencode]
# bin = "/absolute/path/to/ringer/engines/opencode-sandboxed.sh"
# model_default = "openrouter/z-ai/glm-5.2"
# args_template = [
#   "{taskdir}",
#   "{access_args}",
#   "run",
#   "-m",
#   "{model}",
#   "--dangerously-skip-permissions",
#   "--format",
#   "json",
#   "{engine_args}",
#   "--dir",
#   "{taskdir}",
#   "{spec}",
# ]
# sandbox_args = []
# full_access_args = ["--no-sandbox"]
# token_regex = '"tokens":\{"total":([0-9]+)'

[artifact]
# Zero-LLM, self-contained HTML artifacts rendered directly from state — no model calls, no
# network. Three files per config, all pure stdlib templates:
#   - `out`: the live status page, re-rendered on every ~1s state flush while a run is in
#     progress (meta-refresh, no JS needed). Ringside can embed or open this.
#   - `report_out`: the final report, rendered once when a run finishes — full task table,
#     timings, attempts/retries, check output, links to each task's worker.log/report files.
#   - `index_out`: a single multi-run index listing every run under state_dir (handy when
#     several swarms run at once).
# Templates support {run_id} and {run_name} substitution. Disable with --no-artifact.
enabled = true
out = "~/.ringer/artifacts/{run_id}.html"
report_out = "~/.ringer/artifacts/{run_id}-report.html"
index_out = "~/.ringer/artifacts/index.html"

# ── Local lanes added 2026-07-20 ──────────────────────────────────────────
# HARNESS FOLLOWS THE BOSS (user, 2026-07-22): each boss drives k3/qwen
# workers through its OWN native harness.
#   K3-bossed jobs  → [engines.kimi] (k3) and [engines.kimiqwen] (qwen)
#   Fable-bossed jobs → [engines.kimiclaude] (k3) and [engines.qwenclaude] (qwen)
# (History: kimi engine retired 2026-07-22 am in favor of kimiclaude
# everywhere; reversed 2026-07-22 pm for K3-bossed work only.)
#
# [engines.kimi] — K3 workers via the kimi CLI (OAuth plan), used when the
# BOSS is kimi. Prompt mode (-p) auto-approves and cannot combine with
# -y/--auto (verified v0.27.0). No sandbox flag exists; writes are
# unconfined — keep manifests scoped to their task dirs. {model_args}
# expands to "-m kimi-code/k3" (or the k3max alias) so scoreboard
# attribution is exact.
[engines.kimi]
bin = "<PATH-TO>/.kimi-code/bin/kimi"
model_default = "kimi-code/k3"
args_template = ["{access_args}", "{model_args}", "{engine_args}", "-p", "{spec}"]
sandbox_args = []
full_access_args = []

# Qwen 3.8 Max Preview via omp (qwen-token-plan provider, metered). Fallback
# lane only — slow (thinking=max through the Beijing endpoint) and billed per
# token. Root cause of the native qwen CLI "timeouts" found 2026-07-20: NOT
# the backend — qwen-code's default 45s contentGenerator.timeout vs the
# token-plan endpoint's >45s first response. Fixed in ~/.qwen/settings.json
# (contentGenerator.timeout=300000). Prefer [engines.qwencode] below.
[engines.qwen]
bin = "<PATH-TO>/.local/bin/omp"
model_default = "qwen-token-plan/qwen3.8-max-preview"
args_template = ["-p", "--no-session", "--approval-mode", "yolo", "--cwd", "{taskdir}", "--model", "{model}", "{access_args}", "{engine_args}", "{spec}"]
sandbox_args = []
full_access_args = []

# Qwen Code CLI (headless -p; Auto Mode executes tools) against the
# ModelStudio Token Plan — flat-rate, and the plan's sanctioned tool. Model
# ids come from ~/.qwen/settings.json modelProviders: qwen3.8-max-preview,
# qwen3.7-plus, qwen3.6-flash, glm-5.2, deepseek-v4-pro/-flash, kimi-k2.7-code,
# MiniMax-M2.5, ... — route per task via the manifest "model" field. No OS
# sandbox; writes unconfined — scope specs to task dirs. The Beijing endpoint
# has high first-token latency (>45s observed): give tasks generous timeout_s.
[engines.qwencode]
bin = "<PATH-TO>/.local/bin/qwen"
model_default = "qwen3.8-max-preview"
# --approval-mode yolo is hidden from `qwen --help` but real (choices: plan,
# default, auto-edit, auto, yolo). Headless default ("auto") denies
# write_file/run_shell_command — workers can't produce artifacts without it.
args_template = ["{access_args}", "{model_args}", "{engine_args}", "--approval-mode", "yolo", "-o", "json", "-p", "{spec}"]
sandbox_args = []
full_access_args = []
token_regex = '"tokens":\{"prompt":[0-9]+,"candidates":[0-9]+,"total":([0-9]+)'

# Claude Code CLI (OAuth plan) — the opus/sonnet/fable lane, added 2026-07-21.
# Headless mode is -p/--print; verified against v2.1.216 (2026-07-21):
# `--model` takes aliases opus/sonnet/fable or full names (e.g.
# claude-fable-5), `--effort` takes low|medium|high|xhigh|max, and
# `claude -p "..." --model opus --effort max` runs headless end to end.
# `-m` is NOT a short flag for --model (checked `claude --help` 2026-07-21 —
# the only -m-adjacent options are --max-budget-usd and --mcp-config), so this
# block uses the {model} placeholder with an explicit "--model" instead of
# {model_args} (which expands to a literal "-m <model>"). Like the kimi/qwen
# lanes, claude has no OS sandbox on this machine: writes are unconfined, so
# keep manifests scoped to their task dirs. sandbox_args carries
# --dangerously-skip-permissions because headless workers must write files —
# in -p mode permission prompts can never be answered, so without it every
# write stalls (sandbox mode stays explicit per the config invariant).
# Plain text output (no --output-format json): simplest, no token_regex
# (same as kimi), and text mode doesn't self-report the model, so no
# model_report_regex — scoreboard attribution therefore comes from the
# manifest's per-task "model" field, so manifests SHOULD set it
# (model_default covers omission). Per-task effort goes through engine_args,
# e.g. ["--effort", "max"] (verified 2026-07-21). model = "claude-fable-5"
# is the gated red-phone lane for rare advisor/reviewer consults — the boss
# self-authorizes, sparingly.
[engines.claude]
bin = "<PATH-TO>/.local/bin/claude"
model_default = "sonnet"
args_template = ["{access_args}", "--model", "{model}", "{engine_args}", "-p", "{spec}"]
sandbox_args = ["--dangerously-skip-permissions"]
full_access_args = []

# Qwen via the Claude Code harness — added 2026-07-22. The ModelStudio Token
# Plan serves an Anthropic-compatible endpoint and lists Claude Code as an
# officially supported harness; the claude-qwen wrapper sets
# ANTHROPIC_BASE_URL/AUTH_TOKEN (key read from ~/.qwen/settings.json) and
# execs the claude binary. Replaces qwencode as the PRIMARY qwen lane —
# qwencode repeatedly stalled under heavy tasks; keep it as fallback.
# Live plan models (GET /models, 2026-07-22): qwen3.8-max-preview,
# qwen3.7-max, qwen3.7-plus, qwen3.6-flash, deepseek-v4-pro (+glm-5.2
# UNPLUGGED, wan image models). The k2.7/k2.6 slugs in ~/.qwen/settings.json
# are no longer served. Same headless invariants as [engines.claude].
[engines.qwenclaude]
bin = "<PATH-TO>/.local/bin/claude-qwen"
model_default = "qwen3.8-max-preview"
args_template = ["{access_args}", "--model", "{model}", "{engine_args}", "-p", "{spec}"]
sandbox_args = ["--dangerously-skip-permissions"]
full_access_args = []

# Kimi K3 via the Claude Code harness — THE k3 worker lane (user
# 2026-07-22: kimi-code retired from worker duty after kimiclaude went
# 5/5 first-try on the capacity screen, equal-or-faster on every task,
# research 4.8× faster; the CLI remains as the Kimi boss's harness only).
# Same membership cap as the CLI. Endpoint
# honors output_config.effort (verified: low=2.2k vs max=8k thinking
# chars on the primes A/B) → effort is ADAPTIVE, Fable's per-task call,
# passed via engine_args ["--effort", "low"|"high"|"max"] on every
# dispatch (k3 joins the Claude-family adaptive rule; default_effort=high
# if omitted, but never omit). k3 is natively 1M context here.
# k3 ONLY: this endpoint's kimi-for-coding[-highspeed] slugs are K2.7
# ("K2.7 Coding" display name) — BANNED family, never route them.
# k3 at --effort max never types unsupervised builds (sloppy-verify was
# model personality, not harness — the ban survives the swap).
[engines.kimiclaude]
bin = "<PATH-TO>/.local/bin/claude-kimi"
model_default = "k3"
args_template = ["{access_args}", "--model", "{model}", "{engine_args}", "-p", "{spec}"]
sandbox_args = ["--dangerously-skip-permissions"]
full_access_args = []

# Qwen via the Kimi Code harness — added 2026-07-22 (user decision: qwen gets
# a native worker lane). Models resolve through Kimi Code's qwen-token-plan
# provider (OpenAI-compatible Token Plan endpoint; credential shadowing ruled
# out by header capture 2026-07-22). kimi CLI returns as a worker harness for
# QWEN ONLY — k3 workers stay on [engines.kimiclaude] per the morning's
# retirement note. Same headless invariants as the old kimi engine: -p
# auto-approves, no sandbox, writes unconfined — scope manifests to task
# dirs. Effort comes from the kimi-code model alias (reasoning_effort
# injected by Kimi Code; alias default_effort=high today).
[engines.kimiqwen]
bin = "<PATH-TO>/.kimi-code/bin/kimi"
model_default = "qwen-token-plan/qwen3.8-max-preview"
args_template = ["{access_args}", "{model_args}", "{engine_args}", "-p", "{spec}"]
sandbox_args = []
full_access_args = []
