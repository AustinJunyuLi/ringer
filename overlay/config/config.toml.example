# Sample config for ringer.py.
# Copy to ~/.config/ringer/config.toml or pass with --config /path/to/config.toml.

# Default identity stamped into state JSON and eval rows. Resolution order:
# --identity flag > FLEET_IDENTITY / RINGER_IDENTITY env > a .fleet-agent file
# found walking up from the working directory (per-repo agent name) > this
# value > short hostname.
# identity_default = "codex-mini"

# State files live under <state_dir>/runs/<run_id>.json.
state_dir = "~/.ringer"

# First localhost port tried for the per-run dashboard. The server will scan the
# next 49 ports if this one is busy.
dashboard_port_base = 8787

# Optional native HUD app path. Public installs should omit this and let the
# dashboard open in the browser.
# hud_app_path = "/Applications/Ringside.app"

# Belt-and-suspenders full-access gate. A task with "full_access": true will
# still fail unless this is true.
allow_full_access = false

[update]
# Check origin/main before command dispatch and let a long-running HUD check
# again on this interval. Updates apply only as a clean ff-only move on main.
# Set auto=false to disable both automatic paths; `./ringer.py self-update`
# remains available as an explicit check.
# auto = true
# check_interval_s = 3600
# For one command, pass --no-self-update. To disable automatic checks in an
# environment or service, set RINGER_NO_SELF_UPDATE=1.

# Optional model steering. The directory must contain profiles/ with one
# Markdown profile per model. Ringer creates observations/ringer/ beneath this
# directory automatically as attempts finish.
# [steering]
# dir = "~/.ringer/steering"
# inject_candidates = true

[eval]
# Safe public default: write one JSON object per attempt to a local JSONL file.
# Use "postgres" only when [eval.postgres] is configured.
backend = "jsonl"
jsonl_path = "~/.ringer/runs.jsonl"

# Optional Supabase/Postgres logging. The env file should define:
# SUPABASE_DB_HOST, SUPABASE_DB_PORT, SUPABASE_DB_USER,
# SUPABASE_DB_PASSWORD, SUPABASE_DB_NAME.
# [eval.postgres]
# env_file = "~/.supabase.env"

[engines.codex]
# Public default resolves this with shutil.which("codex"). Set an absolute path
# here only for machine-specific installs.
bin = "codex"

# Placeholders:
# - {taskdir}: task working directory
# - {spec}: task prompt/spec
# - {access_args}: expands to sandbox_args or full_access_args
# - {model_args}: expands to "-m <model>" only when the manifest task sets
#   "model" or this engine sets model_default; otherwise it expands to nothing,
#   preserving Codex's configured default. Setting model_default = "gpt-5.6-sol"
#   pins the model instead of inheriting ~/.codex/config.toml drift.
# - {engine_args}: expands to the task's optional "engine_args" list — the orchestrator
#   sets per-task flags here, e.g. ["-c", "model_reasoning_effort=medium"] to match
#   reasoning depth to task difficulty instead of inheriting the CLI-wide default
args_template = [
  "exec",
  "--skip-git-repo-check",
  "{access_args}",
  "{model_args}",
  "{engine_args}",
  "-C",
  "{taskdir}",
  "{spec}",
]

# Never rely on an engine's default sandbox. Be explicit.
sandbox_args = ["--sandbox", "workspace-write"]
full_access_args = ["--dangerously-bypass-approvals-and-sandbox"]

# First capture group should be the integer token count.
token_regex = "tokens\\s+used\\s*:?\\s*([0-9][0-9,]*)"

# First capture group should be the model slug self-reported by the harness.
# Ringer applies this to captured worker output after every attempt. The Codex
# default reads the `model:` header; override it here only if that format changes.
model_report_regex = "(?m)^model:[ \\t]*([^ \\t\\r\\n]+)[ \\t]*\\r?$"

# Grok Build CLI (xAI). Install: curl -fsSL https://x.ai/cli/install.sh | bash
# (or: npm install -g @xai-official/grok), then `grok login`.
# Headless mode (-p) runs a full agentic loop with tools and exits. Grok brings
# its own OS sandbox (Seatbelt on macOS): profile "workspace" = read everywhere,
# write CWD + temp + ~/.grok, network allowed. Models include grok-build and
# grok-composer-2.5-fast; route with the per-task "model" field.
# `--no-auto-update` prevents the CLI from self-updating during a run.
# Uncomment to enable.
# [engines.grok]
# bin = "grok"
# model_default = "grok-composer-2.5-fast"
# args_template = [
#   "--cwd",
#   "{taskdir}",
#   "{access_args}",
#   "-m",
#   "{model}",
#   "--always-approve",
#   "--no-auto-update",
#   "--output-format",
#   "json",
#   "{engine_args}",
#   "-p",
#   "{spec}",
# ]
# sandbox_args = ["--sandbox", "workspace"]
# full_access_args = ["--sandbox", "off", "--permission-mode", "bypassPermissions"]
# Grok's JSON output carries no usage/token fields, so no token regex is needed.
# Its JSON also does not self-report a model, so no model_report_regex is configured.
# token_regex = "\"total_tokens\"\\s*:\\s*([0-9]+)"

# For CI, acceptance evals, and local testing.
# [engines.mock]
# bin = "python3"
# args_template = [
#   "/absolute/path/to/ringer/engines/mock_worker.py",
#   "{spec}",
# ]
# sandbox_args = []
# full_access_args = []

# OpenCode + OpenRouter — a universal model harness. One engine block runs
# any OpenRouter-served model: the {model} placeholder is filled per task from
# the manifest's "model" field, falling back to model_default below.
# OpenCode has no OS sandbox, so `bin` points at engines/opencode-sandboxed.sh
# (macOS Seatbelt: network + reads open, writes confined to the task dir, a
# per-run scratch dir, and OpenCode's state/config dirs). Auth: put your
# OpenRouter key where your OpenCode version expects it — commonly
# ~/.local/share/opencode/auth.json ({"openrouter": {"type": "api", "key": "..."}});
# confirm the path with your installed CLI.
# Per-task engine_args can set reasoning effort ("--variant", "low|high|max").
# Uncomment and set an absolute path for `bin` to enable.
# [engines.opencode]
# bin = "/absolute/path/to/ringer/engines/opencode-sandboxed.sh"
# model_default = "openrouter/<provider>/<model>"
# args_template = [
#   "{taskdir}",
#   "{access_args}",
#   "run",
#   "-m",
#   "{model}",
#   "--dangerously-skip-permissions",
#   "--format",
#   "json",
#   "{engine_args}",
#   "--dir",
#   "{taskdir}",
#   "{spec}",
# ]
# sandbox_args = []
# full_access_args = ["--no-sandbox"]
# token_regex = '"tokens":\{"total":([0-9]+)'

[artifact]
# Zero-LLM, self-contained HTML artifacts rendered directly from state — no model calls, no
# network. Three files per config, all pure stdlib templates:
#   - `out`: the live status page, re-rendered on every ~1s state flush while a run is in
#     progress (meta-refresh, no JS needed). Ringside can embed or open this.
#   - `report_out`: the final report, rendered once when a run finishes — full task table,
#     timings, attempts/retries, check output, links to each task's worker.log/report files.
#   - `index_out`: a single multi-run index listing every run under state_dir (handy when
#     several swarms run at once).
# Templates support {run_id} and {run_name} substitution. Disable with --no-artifact.
enabled = true
out = "~/.ringer/artifacts/{run_id}.html"
report_out = "~/.ringer/artifacts/{run_id}-report.html"
index_out = "~/.ringer/artifacts/index.html"

# Kimi CLI engine. Prompt mode (-p) auto-approves and cannot combine with
# -y/--auto (verified v0.27.0). No sandbox flag exists; writes are unconfined,
# so keep manifests scoped to their task dirs. {model_args} expands to
# "-m kimi-code/k3" (or the k3max alias) for per-task model selection.
[engines.kimi]
bin = "<PATH-TO>/.kimi-code/bin/kimi"
model_default = "kimi-code/k3"
args_template = ["{access_args}", "{model_args}", "{engine_args}", "-p", "{spec}"]
sandbox_args = []
full_access_args = []

# Claude Code CLI. Headless mode is -p/--print. `--model` takes aliases or
# full names, and `--effort` takes low|medium|high|xhigh|max.
# Use the {model} placeholder with an explicit "--model" instead of
# {model_args}, which expands to a literal "-m <model>". Claude has no OS
# sandbox on this machine: writes are unconfined, so keep manifests scoped to
# their task dirs. sandbox_args carries --dangerously-skip-permissions because
# headless workers cannot answer permission prompts.
# Plain text output needs no token_regex or model_report_regex; attribution
# comes from the manifest's per-task "model" field, with model_default covering
# omission. Per-task effort goes through engine_args, e.g. ["--effort", "max"].
[engines.claude]
bin = "<PATH-TO>/.local/bin/claude"
model_default = "sonnet"
args_template = ["{access_args}", "--model", "{model}", "{engine_args}", "-p", "{spec}"]
sandbox_args = ["--dangerously-skip-permissions"]
full_access_args = []

# Kimi K3 via the Claude Code harness. The endpoint supports
# output_config.effort; pass the desired effort through engine_args on each
# dispatch. K3 provides a native 1M context window.
[engines.kimiclaude]
bin = "<PATH-TO>/.local/bin/claude-kimi"
model_default = "k3"
args_template = ["{access_args}", "--model", "{model}", "{engine_args}", "-p", "{spec}"]
sandbox_args = ["--dangerously-skip-permissions"]
full_access_args = []
